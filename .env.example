# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-generate-with-openssl-rand-base64-32"

# Google OAuth (Optional - for Google Login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Provider (Optional - for Email Verification)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"

# AI Provider API Keys (Optional - User can provide their own in settings)
# Get free keys from:
# Google AI Studio: https://aistudio.google.com/apikey (Gemini - generous free tier)
# OpenRouter: https://openrouter.ai/keys (Access to many models)
# Groq: https://console.groq.com/keys (Free fast inference)
# Together AI: https://api.together.xyz/ (Free credits)
# Hugging Face: https://huggingface.co/settings/tokens (Free inference)

GOOGLE_GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
TOGETHER_API_KEY=""
HUGGINGFACE_API_KEY=""

# Default AI Model Preferences (User can override in settings)
DEFAULT_AI_PROVIDER="gemini"
DEFAULT_CHAT_MODEL="gemini-1.5-flash"
DEFAULT_FAST_MODEL="gemini-1.5-flash-8b"

# App Settings
NEXT_PUBLIC_APP_NAME="AI Learning Coach"
NEXT_PUBLIC_APP_DESCRIPTION="Your Personalized AI-Powered Learning Companion"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
ENABLE_AI_FEATURES="true"
ENABLE_VIDEO_CONTENT="true"
ENABLE_HANDWRITTEN_NOTES="true"
ENABLE_QUIZ_SYSTEM="true"
ENABLE_STUDY_PLANS="true"
ENABLE_MULTI_LANGUAGE="true"

# File Upload (Optional - for self-hosted videos/notes)
# UPLOAD_DIR="./public/uploads"
# MAX_FILE_SIZE="52428800" # 50MB

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""